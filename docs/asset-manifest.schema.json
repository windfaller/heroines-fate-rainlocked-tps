{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/heroines-fate/asset-manifest.schema.json",
  "title": "Heroines Fate Runtime Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "project",
    "releaseId",
    "generatedAt",
    "assetBaseUrl",
    "coordinateConvention",
    "groups",
    "assets"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "project": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "assetBaseUrl": { "type": "string", "minLength": 1 },
    "coordinateConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "up", "forward", "gameplayPlane"],
      "properties": {
        "units": { "const": "meters" },
        "up": { "const": "+Y" },
        "forward": { "const": "-Z" },
        "gameplayPlane": { "const": "XZ" }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "nullableInteger": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "nullableObject": {
      "anyOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "referenceUrls"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "referenceUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" },
          "uniqueItems": true
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "licenseOrTerms",
        "provenanceStatus",
        "master",
        "runtime",
        "version",
        "sha256",
        "sizeBytes",
        "dimensionsOrBounds",
        "pivotOrOrigin",
        "criticalGroup",
        "fallback",
        "status",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "skinned-model",
            "static-model",
            "static-model-kit",
            "texture",
            "material",
            "layered-2.5d",
            "image",
            "atlas",
            "animation",
            "vfx",
            "audio",
            "video",
            "font",
            "data"
          ]
        },
        "source": { "$ref": "#/$defs/source" },
        "licenseOrTerms": { "type": "string", "minLength": 1 },
        "provenanceStatus": { "type": "string", "minLength": 1 },
        "master": { "type": "string", "minLength": 1 },
        "runtime": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "version": { "type": "string", "minLength": 1 },
        "sha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            { "const": "UNKNOWN" }
          ]
        },
        "sizeBytes": { "$ref": "#/$defs/nullableInteger" },
        "dimensionsOrBounds": { "$ref": "#/$defs/nullableObject" },
        "pivotOrOrigin": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "coordinateConvention": { "type": "string", "minLength": 1 },
        "budget": { "type": "object" },
        "clips": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "criticalGroup": { "type": "string", "minLength": 1 },
        "lazyGroup": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "proposed",
            "source-ready",
            "processing",
            "runtime-ready",
            "integrated",
            "approved",
            "rejected"
          ]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
